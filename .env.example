# Chat generation: an OpenAI-compatible local server.
# Include the full API base path, such as /v1.
# A server without authentication still requires a dummy API key here.
CHATBOT_API_TYPE="openai"
CHATBOT_ENDPOINT="http://localhost:8000/v1"
CHATBOT_API_KEY="unused"
CHATBOT_MODEL="your-local-model-id"

# Claim decomposition, check-worthiness, and verification: Azure OpenAI.
# Use the resource root with API_TYPE=azure and select a supported API version.
FACTCHECKER_API_TYPE="azure"
FACTCHECKER_ENDPOINT="https://your-resource.openai.azure.com"
FACTCHECKER_API_KEY="your-factchecker-api-key"
FACTCHECKER_API_VERSION="your-supported-api-version"
FACTCHECKER_MODEL="your-factcheck-deployment-name"

# Retrieval defaults. CLI arguments override these optional settings.
# Blank values use the built-in defaults shown below.
TOKENIZER_NAME="llm-jp/llm-jp-3-13b"
ES_HOST="http://localhost:9200"
ES_DUMP_INDEX="llm-jp-corpus-v3"

# Either role can independently use API_TYPE=openai or API_TYPE=azure.
# For openai mode, API_VERSION is ignored. Endpoint examples:
#   OpenAI: https://api.openai.com/v1
#   Azure v1: https://your-resource.openai.azure.com/openai/v1
# For azure mode, API_TYPE, ENDPOINT, API_KEY, and API_VERSION are required.
# For openai mode, API_TYPE, ENDPOINT, and API_KEY are required.
# MODEL values are optional; blank values count as unset.
# Fact-checker model: --engine > FACTCHECKER_MODEL > gpt-4-0613.
# Chatbot model: --chat-engine > CHATBOT_MODEL > resolved fact-checker model.
# Existing process environment variables take precedence over this file.
# MODEL alone does not disable the legacy AZURE_OPENAI_* connection fallback.
# Mock mode (--mock) does not load this file or use environment configuration.
# Restart Streamlit after changing these settings.
